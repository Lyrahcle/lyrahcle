#!/usr/bin/env python3
"""Interactive, one-time enrollment for a Lyrahcle Raspberry Pi station."""

import argparse
import getpass
import os
from pathlib import Path
import re
import subprocess
import sys
import time
from urllib.parse import urlparse

ENV_PATH = Path("/etc/lyrahcle/sdr-agent.env")
CERT_PATH = Path("/var/lib/lyrahcle/identity/agent.crt")
KEY_PATH = Path("/var/lib/lyrahcle/identity/agent.key")
AGENT_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$")


def validate(backend: str, agent_id: str, ca: Path, keys: Path) -> None:
    parsed = urlparse(backend)
    if parsed.scheme != "https" or not parsed.netloc or parsed.username or parsed.password:
        raise ValueError("backend must be an HTTPS URL without embedded credentials")
    if not AGENT_RE.fullmatch(agent_id):
        raise ValueError("agent ID must be 1-128 safe letters, digits, dot, underscore or dash")
    if not ca.is_file():
        raise ValueError(f"backend CA file does not exist: {ca}")
    if not keys.is_dir() or not any(keys.glob("*.pub")):
        raise ValueError(f"configuration key directory has no .pub keys: {keys}")


def write_env(backend: str, agent_id: str, token: str, ca: Path, keys: Path) -> None:
    content = (
        f"BACKEND_URL={backend}\nAGENT_ID={agent_id}\nAGENT_ENROLLMENT_TOKEN={token}\n"
        f"AGENT_CA_CERT={ca}\nAGENT_CERT_FILE={CERT_PATH}\nAGENT_KEY_FILE={KEY_PATH}\n"
        f"AGENT_CONFIG_VERIFY_KEY_DIR={keys}\nAGENT_ROTATE_BEFORE=24h\n"
        "AGENT_IDENTITY_CHECK_INTERVAL=10m\nFREQUENCY_HZ=437500000\n"
        "CAPTURE_INTERVAL_SECONDS=10\n"
        "AGENT_INTEGRITY_PATHS=/usr/local/bin/sdr-agent,/etc/lyrahcle/sdr-agent.env\n"
    )
    ENV_PATH.parent.mkdir(mode=0o750, parents=True, exist_ok=True)
    temporary = ENV_PATH.with_suffix(".tmp")
    fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
        handle.write(content)
        handle.flush()
        os.fsync(handle.fileno())
    os.replace(temporary, ENV_PATH)
    os.chmod(ENV_PATH, 0o600)


def scrub_token() -> None:
    lines = ENV_PATH.read_text(encoding="utf-8").splitlines()
    cleaned = ["AGENT_ENROLLMENT_TOKEN=" if line.startswith("AGENT_ENROLLMENT_TOKEN=") else line for line in lines]
    temporary = ENV_PATH.with_suffix(".tmp")
    temporary.write_text("\n".join(cleaned) + "\n", encoding="utf-8")
    os.chmod(temporary, 0o600)
    os.replace(temporary, ENV_PATH)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--backend")
    parser.add_argument("--agent-id")
    parser.add_argument("--ca", default="/etc/lyrahcle/backend-ca.pem")
    parser.add_argument("--config-key-dir", default="/etc/lyrahcle/config-keys")
    parser.add_argument("--token-stdin", action="store_true")
    parser.add_argument("--no-start", action="store_true", help="write configuration without starting systemd")
    args = parser.parse_args()
    if os.geteuid() != 0:
        print("error: run enrollment as root", file=sys.stderr)
        return 1
    backend = (args.backend or input("Backend HTTPS URL: ")).strip().rstrip("/")
    agent_id = (args.agent_id or input("Unique station/agent ID: ")).strip()
    token = (sys.stdin.readline() if args.token_stdin else getpass.getpass("Single-use enrollment token: ")).strip()
    if not token or any(char.isspace() for char in token):
        print("error: enrollment token is empty or contains whitespace", file=sys.stderr)
        return 2
    try:
        validate(backend, agent_id, Path(args.ca), Path(args.config_key_dir))
        write_env(backend, agent_id, token, Path(args.ca), Path(args.config_key_dir))
    except (OSError, ValueError) as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2
    if args.no_start:
        print(f"Configuration written to {ENV_PATH}; token retained until first enrollment.")
        return 0
    subprocess.run(["systemctl", "enable", "--now", "lyrahcle-sdr-agent.service"], check=True)
    for _ in range(30):
        if CERT_PATH.is_file() and KEY_PATH.is_file():
            scrub_token()
            subprocess.run(["systemctl", "restart", "lyrahcle-sdr-agent.service"], check=True)
            print(f"Agent {agent_id} enrolled; the one-time token was removed.")
            return 0
        time.sleep(1)
    print("error: enrollment timed out; inspect journalctl -u lyrahcle-sdr-agent", file=sys.stderr)
    return 3


if __name__ == "__main__":
    raise SystemExit(main())

