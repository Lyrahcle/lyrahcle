# Written by lyrahcle-enroll. Keep this file owned by root:root with mode 0600.
BACKEND_URL=https://lyrahcle.example.com
AGENT_ID=station-madrid-01
AGENT_ENROLLMENT_TOKEN=
AGENT_CA_CERT=/etc/lyrahcle/backend-ca.pem
AGENT_CERT_FILE=/var/lib/lyrahcle/identity/agent.crt
AGENT_KEY_FILE=/var/lib/lyrahcle/identity/agent.key
AGENT_CONFIG_VERIFY_KEY_DIR=/etc/lyrahcle/config-keys
AGENT_ROTATE_BEFORE=24h
AGENT_IDENTITY_CHECK_INTERVAL=10m
FREQUENCY_HZ=437500000
CAPTURE_INTERVAL_SECONDS=10
AGENT_INTEGRITY_PATHS=/usr/local/bin/sdr-agent,/etc/lyrahcle/sdr-agent.env

