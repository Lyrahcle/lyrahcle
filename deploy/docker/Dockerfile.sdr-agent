FROM golang:1.27.3-alpine AS build
WORKDIR /src
COPY apps/sdr-agent/go.mod ./
COPY apps/sdr-agent/ ./
RUN CGO_ENABLED=0 go build -o /out/lyrahcle-sdr-agent ./cmd/agent

FROM gcr.io/distroless/static-debian12
COPY --from=build /out/lyrahcle-sdr-agent /lyrahcle-sdr-agent
USER nonroot:nonroot
ENTRYPOINT ["/lyrahcle-sdr-agent"]
