# syntax=docker/dockerfile:1
FROM node:26-alpine AS build
WORKDIR /src
COPY apps/frontend/package.json apps/frontend/package-lock.json ./
RUN npm ci
COPY apps/frontend/ ./
RUN npm run build

FROM nginx:1.27-alpine
ENV BACKEND_SCHEME=http \
    BACKEND_UPSTREAM=backend:8080 \
    BACKEND_TLS_VERIFY=off \
    BACKEND_TLS_SERVER_NAME=backend
COPY --from=build /src/dist /usr/share/nginx/html
COPY deploy/docker/nginx.frontend.conf /etc/nginx/templates/default.conf.template
RUN mkdir -p /etc/nginx/backend-ca /var/cache/nginx /var/run \
    && cp /etc/ssl/certs/ca-certificates.crt /etc/nginx/backend-ca/ca.crt \
    && chown -R 101:101 /etc/nginx/conf.d /etc/nginx/templates /etc/nginx/backend-ca /var/cache/nginx /var/run /usr/share/nginx/html
USER 101:101
EXPOSE 8080 8443
