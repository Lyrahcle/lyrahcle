# syntax=docker/dockerfile:1
FROM golang:1-alpine AS build
WORKDIR /src
COPY apps/backend/go.mod apps/backend/go.sum ./
RUN go mod download
COPY apps/backend/ ./
RUN CGO_ENABLED=0 go build -o /out/lyrahcle-backend ./cmd/server

FROM gcr.io/distroless/static-debian12
COPY --from=build /out/lyrahcle-backend /lyrahcle-backend
COPY apps/backend/migrations /migrations
WORKDIR /
USER nonroot:nonroot
EXPOSE 8080
ENTRYPOINT ["/lyrahcle-backend"]
